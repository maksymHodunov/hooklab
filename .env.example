# Ключ OpenRouter: https://openrouter.ai/settings/keys
# Без ключа HookLab працює в демо-режимі на трьох прикладах.
OPENROUTER_API_KEY=

# Модель за замовчуванням (ID з src/models.ts)
HOOKLAB_DEFAULT_MODEL=anthropic/claude-sonnet-5.5

# 1 = примусовий демо-режим навіть із ключем
HOOKLAB_DEMO=0

PORT=3000
